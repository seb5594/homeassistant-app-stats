{
  "name": "homeassistant-app-stats",
  "version": "1.0.0",
  "private": true,
  "description": "Beautiful, shareable analytics for Home Assistant apps and custom integrations. Track adoption, explore versions, and give your open-source projects a home in numbers.",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5050",
    "data": "node scripts/update-data.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vue": "^3.5.44",
    "@lucide/vue": "^1.59.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.4"
  }
}
